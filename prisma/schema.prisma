// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Stock {
  id                 String             @id @default(cuid())
  name               String
  ticker             String             @unique
  exchange           String             @default("NSE")
  sector           String?              @default("")
  holdingsQuantity Float                @default(0)
  quantity           Float
  avgPrice           Float
  currentPrice       Float              @default(0)
  investedValue      Float
  currentValue       Float              @default(0)
  lastPriceUpdatedAt DateTime?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
  transactions       StockTransaction[]
}

model StockTransaction {
  id        String   @id @default(cuid())
  stockId   String
  stock     Stock    @relation(fields: [stockId], references: [id], onDelete: Cascade)
  date      DateTime
  type      String   // BUY | SELL
  quantity  Float
  price     Float
  amount    Float
  createdAt DateTime @default(now())

  @@index([stockId])
  @@index([date])
}

model MutualFund {
  id               String                  @id @default(cuid())
  name             String
  isin             String?
  folioNumber      String?
  amfiCode         String?
  platform         String?
  fundHouse        String?
  fundCategory     String?
  expenseRatio     Float?
  exitLoad         String?
  units            Float                   @default(0)
  avgNav           Float                   @default(0)
  currentNav       Float                   @default(0)
  investedValue    Float                   @default(0)
  currentValue     Float                   @default(0)
  hasActiveSip        Boolean                 @default(false)
  lastNavUpdatedAt    DateTime?
  firstInvestmentDate DateTime?
  source              String                  @default("MANUAL")
  createdAt        DateTime                @default(now())
  updatedAt        DateTime                @updatedAt
  transactions     MutualFundTransaction[]
  sipConfig        SipConfig?
}

model MutualFundTransaction {
  id          String     @id @default(cuid())
  fundId      String
  fund        MutualFund @relation(fields: [fundId], references: [id], onDelete: Cascade)
  date        DateTime
  type        String     // SIP | LUMPSUM | REDEMPTION | SWITCH_IN | SWITCH_OUT | DIVIDEND | CORRECTION
  units       Float
  nav         Float
  amount      Float
  description String?
  autoCreated Boolean    @default(false)
  createdAt   DateTime   @default(now())

  @@index([fundId])
  @@index([date])
}

model SipConfig {
  id                String     @id @default(cuid())
  fundId            String     @unique
  fund              MutualFund @relation(fields: [fundId], references: [id], onDelete: Cascade)
  amount            Float
  dayOfMonth        Int        @default(1)
  startDate         DateTime
  lastProcessedDate DateTime?
  status            String     @default("ACTIVE")
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt
}

model EPFAccount {
  id                  String            @id @default(cuid())
  uan                 String?
  memberId            String?
  employerName        String?
  dateOfBirth         DateTime?
  employeeBalance     Float             @default(0)
  employerBalance     Float             @default(0)
  pensionBalance      Float             @default(0)
  interestRate        Float             @default(8.25)
  employeeMonthly     Float             @default(0)
  employerMonthly     Float             @default(0)
  dayOfMonth          Int               @default(1)
  trackingStartDate   DateTime?
  lastProcessedDate   DateTime?
  trackingStatus      String            @default("ACTIVE")
  latestFinancialYear String?
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt
  transactions        EPFTransaction[]
}

model EPFTransaction {
  id              String      @id @default(cuid())
  accountId       String
  account         EPFAccount  @relation(fields: [accountId], references: [id], onDelete: Cascade)
  wageMonth       String
  transactionDate DateTime
  type            String      // CR | DR | INTEREST | OPENING_BALANCE
  particulars     String?
  wages           Float?
  employeeAmount  Float       @default(0)
  employerAmount  Float       @default(0)
  pensionAmount   Float       @default(0)
  autoCreated     Boolean     @default(false)
  createdAt       DateTime    @default(now())

  @@index([accountId])
  @@index([transactionDate])
}

model FDAccount {
  id              String   @id @default(cuid())
  name            String
  bankName        String
  platform        String
  principal       Float
  interestRate    Float
  compoundingType String
  fdType          String
  startDate       DateTime
  maturityDate    DateTime
  tenureMonths    Int
  currentValue    Float    @default(0)
  maturityValue   Float    @default(0)
  interestEarned  Float    @default(0)
  isAutoRenew     Boolean  @default(false)
  notes           String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model RDAccount {
  id                String    @id @default(cuid())
  name              String
  bankName          String
  platform          String
  monthlyAmount     Float
  interestRate      Float
  startDate         DateTime
  maturityDate      DateTime
  tenureMonths      Int
  dayOfMonth        Int       @default(1)
  currentValue      Float     @default(0)
  totalInvested     Float     @default(0)
  maturityValue     Float     @default(0)
  interestEarned    Float     @default(0)
  isAutoRenew       Boolean   @default(false)
  notes             String?
  lastProcessedDate DateTime?
  status            String    @default("ACTIVE")
  pausedAt          DateTime?
  frozenCorpus      Float?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  topUps            RDTopUp[]
}

model RDTopUp {
  id          String    @id @default(cuid())
  rdId        String
  rd          RDAccount @relation(fields: [rdId], references: [id], onDelete: Cascade)
  amount      Float
  startDate   DateTime
  isRecurring Boolean   @default(false)
  notes       String?
  createdAt   DateTime  @default(now())

  @@index([rdId])
}

model USStock {
  id                  String               @id @default(cuid())
  name                String
  ticker              String               @unique
  exchange            String               @default("NASDAQ")
  quantity            Float
  avgPriceUSD         Float
  currentPriceUSD     Float                @default(0)
  exchangeRate        Float                @default(84)
  investedValueINR    Float                @default(0)
  currentValueINR     Float                @default(0)
  holdingsQuantity    Float                @default(0)
  lastPriceUpdatedAt  DateTime?
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  transactions        USStockTransaction[]
}

model USStockTransaction {
  id           String   @id @default(cuid())
  stockId      String
  stock        USStock  @relation(fields: [stockId], references: [id], onDelete: Cascade)
  date         DateTime
  type         String   // BUY | SELL
  quantity     Float
  priceUSD     Float
  amountUSD    Float
  amountINR    Float
  exchangeRate Float
  createdAt    DateTime @default(now())

  @@index([stockId])
  @@index([date])
}

model Snapshot {
  id            String   @id @default(cuid())
  date          DateTime @unique
  totalNetWorth Float
  stocksValue   Float    @default(0)
  mfValue       Float    @default(0)
  epfValue      Float    @default(0)
  fdValue       Float    @default(0)
  rdValue       Float    @default(0)
  usStocksValue Float    @default(0)
  investedValue Float    @default(0)
  source        String   @default("AUTO")
  createdAt     DateTime @default(now())

  @@index([date])
}

model Milestone {
  id           String    @id @default(cuid())
  title        String
  targetAmount Float
  targetAsset  String?
  achievedDate DateTime?
  isAchieved   Boolean   @default(false)
  sortOrder    Int       @default(0)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}

model CustomAssetClass {
  id          String             @id @default(cuid())
  name        String             @unique
  description String?
  sortOrder   Int                @default(0)
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
  entries     CustomAssetEntry[]
}

model CustomAssetEntry {
  id            String           @id @default(cuid())
  classId       String
  class         CustomAssetClass @relation(fields: [classId], references: [id], onDelete: Cascade)
  name          String
  type          String
  purchasePrice Float            @default(0)
  currentValue  Float
  purchaseDate  DateTime?
  notes         String?
  lastUpdatedAt DateTime         @default(now())
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  @@index([classId])
}

model SnapshotConfig {
  id            String    @id @default(cuid())
  enabled       Boolean   @default(true)
  dayOfWeek     Int       @default(0)
  hour          Int       @default(22)
  refreshPrices Boolean   @default(true)
  lastRunAt     DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}
